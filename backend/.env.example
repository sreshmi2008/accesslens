ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-5
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=sqlite:///./accesslens.db
# Using Supabase instead? Use the "Session pooler" string from Supabase's Connect modal,
# not "Direct connection" - the direct one is IPv6-only and fails on many networks. See
# PROJECT_STATUS.md's "Known bugs" section for details.
# Generate your own: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret-before-running
ACCESS_TOKEN_EXPIRE_MINUTES=10080
RESEND_API_KEY=re_your_key_here
EMAIL_FROM=AccessLens <onboarding@resend.dev>
